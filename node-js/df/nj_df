FROM docker.io/alpine:latest

# Stage 1 - Setup
RUN apk upgrade --update-cache
RUN apk add nodejs npm

# Stage 2 - Cleanup
COPY ./df/vt-release /etc/
RUN mkdir /vtools
COPY ./df/vtools /vtools
RUN ash /vtools/autoclean.sh

RUN mkdir /home/app
WORKDIR /home/app

CMD ["/bin/ash", "/vtools/entrypoint.sh"]
